<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/line" app:cardBackgroundColor="@color/surface" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/ivPreview" android:layout_width="match_parent" android:layout_height="112dp" android:background="@color/canvas" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/tvFileName" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:maxLines="2" android:ellipsize="middle" android:textColor="@color/ink" android:textSize="13sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tvMeta" android:layout_width="match_parent" android:layout_height="20dp" android:paddingHorizontal="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/muted" android:textSize="10sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="end">
            <ImageButton android:id="@+id/btnFavorite" style="@style/ToolButton" android:src="@android:drawable/btn_star_big_off" android:contentDescription="Tambah favorit"/>
            <ImageButton android:id="@+id/btnMore" style="@style/ToolButton" android:src="@android:drawable/ic_menu_more" android:contentDescription="Opsi file"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
