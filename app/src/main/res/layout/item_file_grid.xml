<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:background="@color/canvas">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:src="@drawable/ic_file_generic"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/brand_dark"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:minLines="2"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingTop="2dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="end|center_vertical"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnFavorite"
                style="@style/ToolButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:contentDescription="Favorit"
                android:src="@drawable/ic_star_outline" />

            <ImageButton
                android:id="@+id/btnMore"
                style="@style/ToolButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:contentDescription="Opsi file"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
