<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cloud_app" android:importantForAccessibility="no"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="FastCloud" android:textColor="@color/ink" android:textSize="22sp" android:fontFamily="sans-serif-medium"/>
        <ImageButton android:id="@+id/btnHistory" style="@style/ToolButton" android:src="@android:drawable/ic_menu_recent_history" android:contentDescription="Riwayat upload"/>
        <ImageButton android:id="@+id/btnRefresh" style="@style/ToolButton" android:src="@android:drawable/ic_popup_sync" android:contentDescription="Perbarui file"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/storageSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OBJECT STORAGE" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/brand"/>
        <TextView android:id="@+id/tvStorage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="File saya" android:textColor="@color/ink" android:textSize="24sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Menghubungkan..." android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp" android:background="@drawable/bg_search" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_search" app:tint="@color/muted" android:importantForAccessibility="no"/>
        <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="Cari nama atau path file" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="14sp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:paddingEnd="8dp"/>
        <ImageButton android:id="@+id/btnClearSearch" style="@style/ToolButton" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Hapus pencarian" android:visibility="gone"/>
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" app:tabIndicatorColor="@color/brand" app:tabSelectedTextColor="@color/brand" app:tabTextColor="@color/muted" app:tabRippleColor="@color/accent_soft" app:tabMode="fixed" app:tabGravity="fill"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingHorizontal="16dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/categoryChips" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip android:id="@+id/chip0" style="@style/FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Semua" android:checkable="true" android:checked="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip1" style="@style/FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gambar" android:checkable="true" android:checked="false"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip2" style="@style/FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PDF" android:checkable="true" android:checked="false"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip3" style="@style/FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teks" android:checkable="true" android:checked="false"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip4" style="@style/FilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lainnya" android:checkable="true" android:checked="false"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/btnFolder" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:drawableStart="@android:drawable/ic_menu_agenda" android:drawablePadding="6dp" android:drawableTint="@color/brand" android:background="?attr/selectableItemBackground" android:text="Semua folder" android:textSize="13sp" android:textColor="@color/ink" android:maxLines="1" android:ellipsize="middle"/>
        <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted" android:paddingStart="8dp"/>
        <ImageButton android:id="@+id/btnSort" style="@style/ToolButton" android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="Urutkan file"/>
        <ImageButton android:id="@+id/btnViewMode" style="@style/ToolButton" android:src="@android:drawable/ic_dialog_dialer" android:contentDescription="Tampilan grid"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvFiles" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="8dp" android:paddingHorizontal="12dp" android:paddingBottom="88dp"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_search" app:tint="@color/muted" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/tvEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvEmptyMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="20dp" android:orientation="vertical" android:gravity="end">
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/fabNewFolder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Buat Folder" android:textColor="@color/surface" app:icon="@android:drawable/ic_input_add" app:iconTint="@color/surface" app:backgroundTint="@color/brand"/>
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/fabUpload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upload" android:textColor="@color/surface" app:icon="@android:drawable/ic_menu_upload" app:iconTint="@color/surface" app:backgroundTint="@color/brand"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/uploadPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/accent_soft" android:visibility="gone">
        <TextView android:id="@+id/tvUploadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:textColor="@color/ink" android:textSize="13sp"/>
        <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="@color/brand"/>
    </LinearLayout>
</LinearLayout>
