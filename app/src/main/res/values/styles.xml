<resources>
    <style name="Base.FastCloudStorage" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">#20252B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.FastCloudStorage" parent="Base.FastCloudStorage" />
    <style name="ToolButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/muted</item>
    </style>
    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
